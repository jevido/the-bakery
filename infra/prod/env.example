# Environment variables set on Coolify. Names only here; values live in
# Coolify, never in the repo.

## bakery-api (runtime)
APP_NAME=the-bakery-api
APP_URL=
APP_KEY=            # 32 random characters
JWT_SECRET=         # long random string; changing it signs everyone out
JWT_TTL=43200       # minutes (30 days)
LOG_LEVEL=info
WEB_ORIGIN=https://bakery.jevido.app   # the website, allowed to call the API with its session cookie
DB_CONNECTION=postgres
DB_HOST=            # the Coolify database's uuid (its container name)
DB_PORT=5432
DB_DATABASE=bakery
DB_USERNAME=bakery
DB_PASSWORD=
# Set by the image: APP_ENV=production APP_HOST=0.0.0.0 APP_PORT=4810
# LOG_PRINT=true MIGRATE_ON_START=true

## bakery-web (build time)
VITE_API_URL=
