# The Bakery API. Build from the repository root:
#   podman build -f infra/images/api/Containerfile .
# Configuration comes from the environment only (see infra/*/env.example);
# no .env is baked in.

FROM docker.io/library/golang:1.27 AS build
WORKDIR /src/services/api
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ ./
# pgx is pure Go, so the binary needs no libc.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api . \
 && mkdir -p /out/storage

# Alpine rather than distroless: Coolify's health check runs curl or wget
# through /bin/sh inside the container (busybox provides both).
FROM docker.io/library/alpine:3
RUN adduser -D -H -u 10001 bakery
WORKDIR /app
COPY --from=build --chown=bakery:bakery /out/api /app/api
# Goravel writes logs and file sessions under storage/.
COPY --from=build --chown=bakery:bakery /out/storage /app/storage
COPY --chmod=0755 infra/images/api/entrypoint.sh /app/entrypoint.sh
ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_HOST=0.0.0.0 \
    APP_PORT=4810 \
    LOG_PRINT=true \
    MIGRATE_ON_START=true
EXPOSE 4810
HEALTHCHECK --interval=2s --timeout=2s --retries=2 CMD wget -qO- http://127.0.0.1:4810/api/health || exit 1
USER bakery
ENTRYPOINT ["/app/entrypoint.sh"]
