# Serves the built website. TLS is Coolify's proxy's job; this listens on
# plain HTTP.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed build output never changes under the same name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Every other path is the single-page app; always revalidate index.html.
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
