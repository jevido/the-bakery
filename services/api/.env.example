APP_NAME=the-bakery-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Also print log lines to stdout (containers set this to true).
LOG_PRINT=false

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://127.0.0.1:4810
APP_HOST=127.0.0.1
APP_PORT=4810
# The website origin(s) allowed to call the API with cookies, comma-separated.
WEB_ORIGIN=http://127.0.0.1:4840
# The operator console origin(s), comma-separated.
CONSOLE_ORIGIN=http://127.0.0.1:4850

JWT_SECRET=
# Token lifetime in minutes (30 days).
JWT_TTL=43200

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=4820
DB_DATABASE=bakery
DB_USERNAME=bakery
DB_PASSWORD=bakery

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
