# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5434/local"

ORIGIN=""

# Bare hostname every app's default subdomain is provisioned under (task 02
# of Phase 05), e.g. "bakery.example.com" — apps get
# <app>.<guild-slug>.<bakery-domain>. Falls back to bakery.localhost in dev.
# Requires wildcard DNS (*.<bakery-domain>, or per-guild *.<guild-slug>.
# <bakery-domain> if guild slugs are delegated their own zone) pointing at
# Bakery's infrastructure — an external DNS step, not something this app
# configures for you.
BAKERY_DOMAIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App (repo access + webhooks for Sources/build pipeline)
# https://github.com/settings/apps
GITHUB_APP_ID=""
# The app's slug, e.g. from github.com/settings/apps/<slug> — used to build
# the install URL github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=""
# Base64-encoded PEM private key downloaded from the app's settings page
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# App envVar secrets (task 02) — AES-256-GCM key for encrypting envVar.valueCiphertext
# at rest, separate from BETTER_AUTH_SECRET. 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating requires re-encrypting every envVar row under the new key in one pass
# (see src/lib/server/secrets/crypto.ts) — old and new keys can't coexist mid-rotation.
ENCRYPTION_KEY=""

# Bakery-hosted container registry (task 08) — `docker compose up` runs it
# locally (see compose.yaml). Host/port the build worker pushes to and hosts'
# agents pull from; in production this is registry.<bakery-domain>.
BAKERY_REGISTRY_HOST="localhost:5050"
# Push credentials used by the build worker. Pull credentials are a single
# shared account for all host agents in this v1 baseline — see
# registry-auth/README.md; real per-host scoping is Phase 07.
# After setting these, run `bun scripts/generate-registry-htpasswd.ts` to
# (re)generate registry-auth/htpasswd, which the registry container reads.
BAKERY_REGISTRY_PUSH_USERNAME=""
BAKERY_REGISTRY_PUSH_PASSWORD=""
BAKERY_REGISTRY_PULL_USERNAME=""
BAKERY_REGISTRY_PULL_PASSWORD=""

# Optional, and only ever set on the one Bakery host that's ALSO running the
# control plane itself (Phase 08 task 04) — everywhere else these stay unset
# and caddyfileContentForHost() behaves exactly as it did before this task.
# CONTROL_PLANE_HOST_ID is that host's own `host.id` row (set once, after
# enrolling this box as a host per Phase 08 task 08 — it doesn't exist yet
# at first install, so this is filled in after the fact).
CONTROL_PLANE_HOST_ID=""
# The control plane's own public domain (e.g. "jevido.app") and the local
# port its container publishes to (see compose.prod.yaml's `bakery` service).
CONTROL_PLANE_DOMAIN=""
CONTROL_PLANE_PORT="3000"
# The private registry's own public domain (e.g. "registry.jevido.app"),
# fronted by the same shared Caddy instance — see registry-auth/README.md.
BAKERY_REGISTRY_PUBLIC_DOMAIN=""

# Production-only compose.prod.yaml overrides (Phase 08 task 05) — dev never
# invokes compose.prod.yaml, so these have no effect locally.
# Overrides compose.yaml's hardcoded dev Postgres password.
POSTGRES_PASSWORD=""
# Pins the control plane image tag a deploy pulls (task 06 sets this to a
# specific commit SHA); defaults to "latest" if unset.
BAKERY_IMAGE_TAG=""
