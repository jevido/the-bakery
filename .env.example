# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5434/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App (repo access + webhooks for Sources/build pipeline)
# https://github.com/settings/apps
GITHUB_APP_ID=""
# The app's slug, e.g. from github.com/settings/apps/<slug> — used to build
# the install URL github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=""
# Base64-encoded PEM private key downloaded from the app's settings page
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Bakery-hosted container registry (task 08) — `docker compose up` runs it
# locally (see compose.yaml). Host/port the build worker pushes to and hosts'
# agents pull from; in production this is registry.<bakery-domain>.
BAKERY_REGISTRY_HOST="localhost:5050"
# Push credentials used by the build worker. Pull credentials are a single
# shared account for all host agents in this v1 baseline — see
# registry-auth/README.md; real per-host scoping is Phase 07.
# After setting these, run `bun scripts/generate-registry-htpasswd.ts` to
# (re)generate registry-auth/htpasswd, which the registry container reads.
BAKERY_REGISTRY_PUSH_USERNAME=""
BAKERY_REGISTRY_PUSH_PASSWORD=""
BAKERY_REGISTRY_PULL_USERNAME=""
BAKERY_REGISTRY_PULL_PASSWORD=""
